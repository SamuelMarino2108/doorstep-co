<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>DoorstepCO.Core</RootNamespace>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <PackageId>DoorstepCO.Core</PackageId>
    <Description>Parses, normalizes and validates free-text Colombian addresses.</Description>
    <Authors>Samuel Marino</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageTags>colombia;address;parser;normalization;logistics</PackageTags>
    <Version>0.1.0</Version>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageProjectUrl>https://github.com/SamuelMarino2108/doorstep-co</PackageProjectUrl>
    <RepositoryUrl>https://github.com/SamuelMarino2108/doorstep-co</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <ItemGroup>
    <None Include="..\..\README.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DoorstepCO.Core.Tests" />
  </ItemGroup>

</Project>
